# Application Config
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="AD Computer"
NEXT_PUBLIC_APP_TAGLINE="Solusi IT Profesional, Service Komputer & Konsultasi Teknologi Terpercaya"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Prisma)
# Default is SQLite for zero-configuration local development.
# To switch to PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# To switch to MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="file:./dev.db"

# Authentication & Security
AUTH_SECRET="it-service-secret-key-change-in-production-super-secure-32chars"
JWT_SECRET="it-service-jwt-token-secret-production"

# AI Assistant Integration (Prepared for OpenAI / Gemini API)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Business Info Config
NEXT_PUBLIC_COMPANY_PHONE="+62 856-2429-9894"
NEXT_PUBLIC_COMPANY_EMAIL="support@itservice-system.com"
NEXT_PUBLIC_COMPANY_ADDRESS="Jalan Kapten Samadikun 10, RT 02/RW 10, No.022, Kota Cirebon, Jawa Barat"

# WhatsApp Click-to-Chat (Frontend / Public)
WHATSAPP_NUMBER="6285624299894"
NEXT_PUBLIC_WHATSAPP_NUMBER="6285624299894"

# ==============================================================================
# 1. TELEGRAM REAL-TIME NOTIFICATION
# ==============================================================================
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="123456789:ABC-DEF_ghijk-lmnopqrstuvwxyz"
# Dapatkan ID chat/grup admin dari @userinfobot atau API getUpdates
TELEGRAM_CHAT_ID="123456789"

# ==============================================================================
# 2. WHATSAPP NOTIFICATION SERVICE (Meta Cloud API / Fonnte / Webhook)
# ==============================================================================
# Pilihan provider: "meta" (Official Meta WhatsApp Business Cloud API), "fonnte", atau "generic"
WHATSAPP_PROVIDER="meta"

# Nomor WhatsApp Admin penerima alert (format internasional tanpa +, contoh: 6285624299894)
# Default otomatis menggunakan WHATSAPP_NUMBER jika tidak dispesifikasikan.
WHATSAPP_ADMIN_RECIPIENT="6285624299894"

# --- Provider Option 1: Meta WhatsApp Business Cloud API (Official Graph API v20.0) ---
# Dapatkan dari Meta for Developers Console -> App Dashboard -> WhatsApp -> API Setup:
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Opsional: Nama template jika menggunakan pre-approved template untuk pengiriman di luar window 24 jam
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="id"

# --- Provider Option 2: Fonnte API (Official Indonesian WhatsApp Gateway) ---
# Dapatkan API token dari dashboard https://fonnte.com:
WHATSAPP_API_TOKEN=""

# --- Provider Option 3: Generic Webhook URL ---
# WHATSAPP_WEBHOOK_URL="https://your-server.com/api/whatsapp-webhook"

# Aktifkan notifikasi status servis ke nomor customer (true/false, default: true)
WHATSAPP_NOTIFY_CUSTOMER="true"

# Aktifkan notifikasi ke nomor WhatsApp Admin (true/false, default: true)
WHATSAPP_NOTIFY_ADMIN="true"
